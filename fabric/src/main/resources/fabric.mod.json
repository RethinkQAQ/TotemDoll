{
  "schemaVersion": 1,
  "id": "${modId}",
  "version": "${modVersion}",
  "name": "${modName}",
  "description": "${modDescription}",
  "authors": ["${modAuthor}"],
  "license": "${modLicense}",
  "icon": "itemdoll.png",
  "environment": "client",
  "entrypoints": {
    "main": ["com.rethinkqaq.totemdoll.TotemDollMod"],
    "client": ["com.rethinkqaq.totemdoll.TotemDollFabricClient"]
  },
  "mixins": ["${modId}.mixins.json", "${modId}.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabricLoaderVersion}",
    "fabric-api": "*",
    "minecraft": "${minecraftVersion}",
    "java": ">=${javaVersion}"
  }
}

{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": ["${mod_author}"],
  "license": "${license}",
  "icon": "itemdoll.png",
  "environment": "client",
  "entrypoints": {
    "main": ["com.rethinkqaq.totemdoll.TotemDollMod"],
    "client": ["com.rethinkqaq.totemdoll.TotemDollFabricClient"],
    "modmenu": ["com.rethinkqaq.totemdoll.coustomapi.ModMenuApiImpl"]
  },
  "contact": {
    "repo": "https://github.com/RethinkQAQ/TotemDoll",
    "issues": "https://github.com/RethinkQAQ/TotemDoll/issues"
  },
  "mixins": ["${mod_id}.mixins.json", "${mod_id}.fabric.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_min_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version_range_fabric}",
    "java": ">=${java_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "github": "https://github.com/RethinkQAQ/TotemDoll"
      }
    }
  }
}

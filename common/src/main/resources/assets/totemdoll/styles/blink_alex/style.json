{
  "format": 3,
  "id": "totemdoll:blink_alex",
  "origin": "builtin",
  "name": "Blinking Alex Doll",
  "name_key": "doll.totemdoll.blink_alex",
  "model": {
    "type": "mesh",
    "geometry": "models/geometry.json"
  },
  "textures": {
    "base": "textures/open.png",
    "open": "textures/open.png",
    "half": "textures/half.png",
    "close": "textures/close.png",
    "activate": "textures/activate.png"
  },
  "features": {
    "animations": true,
    "dynamic_textures": true
  },
  "texture_animations": {
    "blink": {
      "type": "frame_sequence",
      "frames": ["open", "half", "close", "half", "open"],
      "frame_duration": 3,
      "trigger": "random_idle",
      "interval": { "min": 80, "max": 180 }
    },
    "activate": {
      "type": "frame_sequence",
      "frames": ["activate"],
      "frame_duration": 40,
      "trigger": "on_totem_activate",
      "interval": { "min": 0, "max": 0 }
    }
  },
  "compatibility": {
    "display_overrides": [{
      "mods": ["firstperson", "punchy"],
      "match": "any",
      "perspective": "firstperson",
      "contexts": {
        "thirdperson_righthand": {
          "rotation": [0, -180, 0],
          "translation": [0, 3.5, 0],
          "scale": [0.5, 0.5, 0.5]
        },
        "thirdperson_lefthand": {
          "rotation": [0, -180, 0],
          "translation": [0, 3.5, 0],
          "scale": [0.5, 0.5, 0.5]
        }
      }
    }]
  }
}

{
  "format": 3,
  "id": "example:animated_example",
  "name": "Animated Example",
  "model": {
    "type": "mesh",
    "geometry": "models/geometry.json",
    "animations": "models/animations.json"
  },
  "textures": { "base": "textures/base.png" },
  "skin": {
    "supported": true,
    "format": "minecraft_64x64",
    "target": "base",
    "mapping": "minecraft_player"
  },
  "features": { "animations": true, "dynamic_textures": true },
  "texture_animations": {
    "activate_texture": {
      "type": "frame_sequence",
      "frames": ["base"],
      "frame_duration": 20,
      "trigger": "linked"
    }
  },
  "animations": {
    "idle": { "animation": "idle", "trigger": "loop", "priority": 20 },
    "activate": {
      "animation": "totem_activate",
      "trigger": "on_totem_activate",
      "priority": 100,
      "interrupt": true,
      "texture_animation": "activate_texture"
    }
  }
}
